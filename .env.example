# Telegram bot token from @BotFather (/newbot). Leave empty to run admin + simulator only.
TELEGRAM_BOT_TOKEN=

# LLM option A (default): Cloudflare Workers AI. Token needs "Workers AI" permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# LLM option B: any OpenAI-compatible provider (used when CF_* are empty)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Optional model overrides
# LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# LLM_FALLBACK_MODEL=@cf/openai/gpt-oss-120b
# Soft caps: calls per minute and tokens per minute per model (0 = unlimited)
# LLM_MAX_RPM=240
# LLM_TPM=0

# Admin console password (change it!)
ADMIN_PASSWORD=demo
# Shared secret the Google Form Apps Script sends to /api/intake/gform
INTAKE_SECRET=change-me
# Public base URL once exposed (cloudflared/ngrok/Railway). Used for links in the admin UI.
PUBLIC_URL=http://localhost:3000
PORT=3000
DB_PATH=data/funnel.db
# Enables /reset in the bot so you can rehearse the demo repeatedly
DEMO_MODE=true
